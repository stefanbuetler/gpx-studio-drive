# Server-only OAuth configuration. Copy to .dev.vars in the repository root.
# Never use a PUBLIC_ prefix for these secrets.
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
# Generate with: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
DRIVE_SESSION_SECRET=YOUR_64_HEX_CHARACTER_SESSION_KEY
DRIVE_ALLOWED_ORIGINS=http://localhost:5173,https://feature-google-drive-integration-gpx-studio-drive.stefan-buetler.workers.dev
