PUBLIC_MAPTILER_KEY=YOUR_MAPTILER_KEY
# Optional: Google OAuth Web Client ID for browser-based Drive integration
# Optional override for the existing public client ID. Register http://localhost:5173
# as an Authorized JavaScript origin on the same OAuth client. No client secret is needed.
# PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID

# Google Drive API key restricted to this app's website origins and Google Drive API.
# Public browser key, not an OAuth client secret.
# PUBLIC_GOOGLE_API_KEY=YOUR_RESTRICTED_GOOGLE_DRIVE_API_KEY
# Public app URL used when creating share links from localhost.
# PUBLIC_APP_URL=https://YOUR_FEATURE_PREVIEW_DOMAIN
